@model CheckoutInfo
@{
    ViewData["Title"] = "Checkout";
    decimal total = ViewBag.Total ?? 0m;
}

@section scripts {
    @* These two libraries drive unobtrusive client-side validation.
       They live here rather than in _Layout so pages that don't need
       them don't pay to download them (Ch11, slide 67).
       minimum-age.js must come AFTER them -- it depends on jQuery. *@
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/minimum-age.js"></script>
}

<h2 class="mt-3">Checkout</h2>
<p class="text-muted">
    Order total: <strong>@total.ToString("C")</strong>. Please enter your details below.
</p>

@* Model-level messages only -- property-level errors appear beside each field *@
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<form asp-action="Checkout" method="post" style="max-width:700px;">

    <div class="row mb-3">
        <div class="col-md-3">
            <label asp-for="FullName" class="form-label"></label>
        </div>
        <div class="col-md-5">
            <input asp-for="FullName" class="form-control" />
        </div>
        <div class="col-md-4">
            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-3">
            <label asp-for="Email" class="form-label"></label>
        </div>
        <div class="col-md-5">
            <input asp-for="Email" class="form-control" />
        </div>
        <div class="col-md-4">
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-3">
            <label asp-for="ConfirmEmail" class="form-label"></label>
        </div>
        <div class="col-md-5">
            <input asp-for="ConfirmEmail" class="form-control" />
        </div>
        <div class="col-md-4">
            <span asp-validation-for="ConfirmEmail" class="text-danger"></span>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-3">
            <label asp-for="Phone" class="form-label"></label>
        </div>
        <div class="col-md-5">
            <input asp-for="Phone" class="form-control" placeholder="123-456-7890" />
        </div>
        <div class="col-md-4">
            <span asp-validation-for="Phone" class="text-danger"></span>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-3">
            <label asp-for="DOB" class="form-label"></label>
        </div>
        <div class="col-md-5">
            <input asp-for="DOB" class="form-control" type="text"
                   placeholder="mm/dd/yyyy" />
        </div>
        <div class="col-md-4">
            <span asp-validation-for="DOB" class="text-danger"></span>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-3"></div>
        <div class="col-md-5">
            <div class="form-check">
                <input asp-for="AgreeToRules" class="form-check-input" />
                <label asp-for="AgreeToRules" class="form-check-label"></label>
            </div>
        </div>
        <div class="col-md-4">
            <span asp-validation-for="AgreeToRules" class="text-danger"></span>
        </div>
    </div>

    <div class="row">
        <div class="offset-md-3 col">
            <button type="submit" class="btn btn-success">Pay &amp; Confirm</button>
            <a asp-action="Index" class="btn btn-secondary ms-2">Back to Cart</a>
        </div>
    </div>
</form>
