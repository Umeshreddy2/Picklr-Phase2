@model List<CartItem>
@{
    ViewData["Title"] = "My Cart";
}

<h2 class="mt-3">My Cart</h2>

@if (Model.Count == 0)
{
    <div class="alert alert-info">Your cart is empty.</div>
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Continue Browsing</a>
}
else
{
    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Program</th>
                <th>Club</th>
                <th>Date</th>
                <th>Fee</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Count; i++)
            {
                var item = Model[i];
                <tr>
                    <td>@item.ProgramName</td>
                    <td>@item.ClubName</td>
                    <td>@item.Date.ToString("MM/dd/yyyy")</td>
                    <td>@item.Fee.ToString("C")</td>
                    <td>
                        <form asp-action="Remove" method="post">
                            <input type="hidden" name="index" value="@i" />
                            <button type="submit" class="btn btn-outline-danger btn-sm">Remove</button>
                        </form>
                    </td>
                </tr>
            }
            <tr>
                <td colspan="3" class="text-end fw-bold">Total</td>
                <td class="fw-bold">@Model.Sum(c => c.Fee).ToString("C")</td>
                <td></td>
            </tr>
        </tbody>
    </table>

    @* Phase 3: this now goes to the Checkout form instead of booking
       immediately, so customer details can be collected and validated. *@
    <a asp-action="Checkout" class="btn btn-success">Proceed to Checkout</a>
    <form asp-action="ClearAll" method="post" class="d-inline">
        <button type="submit" class="btn btn-outline-danger">Clear All</button>
    </form>
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Continue Browsing</a>
}
